{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "wordsmith",
  "version": "1.0.0",
  "identifier": "net.wearedogs.wordsmith",
  "build": {
    "beforeDevCommand": "npm run devVite -- --host 0.0.0.0",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../../dist"
  },
  "app": {
    "windows": [{ "title": "wordsmith", "width": 1200, "height": 800, "minWidth": 320, "minHeight": 320 }],
    "security": { "csp": null }
  },
  "bundle": { "active": true, "targets": "all" }
}
