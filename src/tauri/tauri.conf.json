{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "wordsmith",
  "version": "1.0.0",
  "identifier": "net.wearedogs.wordsmith",
  "build": {
    "beforeDevCommand": "npm run devVite -- --host 0.0.0.0",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../../dist"
  },
  "app": {
    "windows": [
      {
        "title": "wordsmith",
        "width": 1200,
        "height": 800,
        "minWidth": 320,
        "minHeight": 320,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/YEAHDOGS/wordsmith/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNENEZBQkM5QjAzNUUyMTEKUldRUjRqV3d5YXRQUGJEODJFRmtQdmpvOUlVSWdnZzBPWXRIVS9ZTjgwa3JjaTZOQU4yUnplWXEK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
